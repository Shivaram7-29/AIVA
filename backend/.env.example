# Get your FREE API key from: https://console.groq.com
# 1. Go to https://console.groq.com
# 2. Sign up with Google/GitHub
# 3. Create a new API key
# 4. Create a file named '.env' in this folder and paste the key below:

GROQ_API_KEY=your_groq_api_key_here

# Adzuna Job Search API (FREE — https://developer.adzuna.com/)
# 1. Go to https://developer.adzuna.com/developer/signup
# 2. Sign up and create an application
# 3. Get your APP_ID and APP_KEY
# 4. Add them below:

ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Coding Round — code execution provider (Judge0-compatible)
# Leave both unset to keep the Coding Round's question browsing, timer,
# navigation, and code-saving fully working; Run/Submit will return a
# clear "not configured" message instead of executing code until these
# are set.
#
# Works with either a self-hosted Judge0 instance or a hosted provider
# such as Judge0 CE on RapidAPI.

JUDGE0_API_URL=https://your-judge0-instance.example.com
JUDGE0_API_KEY=your_judge0_api_key_here
