# ── Groq AI (FREE — https://console.groq.com) ─────────────────────────────
# Get your free API key (no credit card needed) and paste it below.
GROQ_API_KEY=

# Groq model to use. Default works out of the box on the free tier.
# NOTE: 'llama-3.3-70b-versatile' was decommissioned by Groq on 2026-08-16
# (free/developer tier) — use openai/gpt-oss-120b or another model from
# https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Optional: comma-separated fallback models tried ONLY if GROQ_MODEL is
# unavailable (decommissioned / invalid). Leave empty for defaults.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Organization-level free-plan protection. The default 6,000 TPM leaves
# margin below Groq's observed 8,000 TPM limit. Do not set above 8,000.
GROQ_FREE_TPM_BUDGET=6000
# Maximum estimated tokens reserved by any one request.
GROQ_SAFE_REQUEST_TOKENS=5500
# Maximum estimated user-prompt tokens after deterministic compaction.
GROQ_SAFE_INPUT_TOKENS=4200

# ── Adzuna Jobs API (FREE — https://developer.adzuna.com/signup) ──────────
# Create a free account to get your credentials. Used for real job search.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
